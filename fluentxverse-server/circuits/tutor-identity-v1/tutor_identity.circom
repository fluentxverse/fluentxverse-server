pragma circom 2.1.6;
include "poseidon.circom";
include "eddsaposeidon.circom";
include "comparators.circom";

// Proves a platform attestation, not government issuance or image authenticity.
template TutorIdentity() {
    signal input policyHash;
    signal input issuerAx;
    signal input issuerAy;
    signal input chainId;
    signal input collection;
    signal input holder;
    signal input credentialCommitment;
    signal input issuedAt;
    signal input mock;
    signal input subjectSecret;
    signal input evidenceSecret;
    signal input adultConfirmed;
    signal input liveMatch;
    signal input interviewPassed;
    signal input signatureR8x;
    signal input signatureR8y;
    signal input signatureS;
    signal output valid;

    adultConfirmed === 1;
    liveMatch === 1;
    interviewPassed === 1;
    mock * (mock - 1) === 0;
    component chainBits = Num2Bits(64); chainBits.in <== chainId;
    component collectionBits = Num2Bits(160); collectionBits.in <== collection;
    component holderBits = Num2Bits(160); holderBits.in <== holder;
    component timeBits = Num2Bits(64); timeBits.in <== issuedAt;
    component nonzero[7];
    nonzero[0] = IsZero(); nonzero[0].in <== policyHash; nonzero[0].out === 0;
    nonzero[1] = IsZero(); nonzero[1].in <== chainId; nonzero[1].out === 0;
    nonzero[2] = IsZero(); nonzero[2].in <== collection; nonzero[2].out === 0;
    nonzero[3] = IsZero(); nonzero[3].in <== holder; nonzero[3].out === 0;
    nonzero[4] = IsZero(); nonzero[4].in <== subjectSecret; nonzero[4].out === 0;
    nonzero[5] = IsZero(); nonzero[5].in <== evidenceSecret; nonzero[5].out === 0;
    nonzero[6] = IsZero(); nonzero[6].in <== issuedAt; nonzero[6].out === 0;
    component commitment = Poseidon(7);
    commitment.inputs[0] <== subjectSecret;
    commitment.inputs[1] <== evidenceSecret;
    commitment.inputs[2] <== policyHash;
    commitment.inputs[3] <== chainId;
    commitment.inputs[4] <== collection;
    commitment.inputs[5] <== holder;
    commitment.inputs[6] <== mock;
    credentialCommitment === commitment.out;
    component message = Poseidon(11);
    message.inputs[0] <== policyHash;
    message.inputs[1] <== chainId;
    message.inputs[2] <== collection;
    message.inputs[3] <== holder;
    message.inputs[4] <== credentialCommitment;
    message.inputs[5] <== issuedAt;
    message.inputs[6] <== mock;
    message.inputs[7] <== adultConfirmed;
    message.inputs[8] <== liveMatch;
    message.inputs[9] <== interviewPassed;
    message.inputs[10] <== evidenceSecret;
    component signature = EdDSAPoseidonVerifier();
    signature.enabled <== 1;
    signature.Ax <== issuerAx; signature.Ay <== issuerAy;
    signature.R8x <== signatureR8x; signature.R8y <== signatureR8y;
    signature.S <== signatureS; signature.M <== message.out;
    valid <== 1;
}
component main {public [policyHash,issuerAx,issuerAy,chainId,collection,holder,credentialCommitment,issuedAt,mock]} = TutorIdentity();
