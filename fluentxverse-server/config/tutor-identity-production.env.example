# Stage only after provisioning and pinning a separate production release.
TUTOR_IDENTITY_ISSUANCE_ENABLED=false
TUTOR_IDENTITY_ISSUANCE_MODE=production
TUTOR_IDENTITY_RELEASE_PATH=/run/tutor-identity-prover/production/release.json
TUTOR_IDENTITY_RELEASE_SHA256=replace-with-reviewed-manifest-sha256
TUTOR_IDENTITY_ENGINE_API_BASE=http://dedicated-engine:8090
TUTOR_IDENTITY_ENGINE_API_KEY=replace-with-dedicated-production-key
